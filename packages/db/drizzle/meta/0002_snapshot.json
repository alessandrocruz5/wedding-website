        "rsvp_responses_email_reserved_domain": {
          "name": "rsvp_responses_email_reserved_domain",
          "value": "lower(\"rsvp_responses\".\"email\") ~ '^[^@[:space:]]+@([a-z0-9-]+[.])*(example[.](com|net|org)|[a-z0-9-]+[.](test|example|invalid))$'"
        },
        "rsvp_responses_text_length": {
          "name": "rsvp_responses_text_length",
          "value": "coalesce(char_length(\"rsvp_responses\".\"shuttle\"), 0) <= 100\n        and coalesce(char_length(\"rsvp_responses\".\"dietary\"), 0) <= 1000\n        and coalesce(char_length(\"rsvp_responses\".\"song\"), 0) <= 200\n        and coalesce(char_length(\"rsvp_responses\".\"note\"), 0) <= 2000"
        }
