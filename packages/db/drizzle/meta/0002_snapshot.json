        "rsvp_responses_guests_shape": {
          "name": "rsvp_responses_guests_shape",
          "value": "case when jsonb_typeof(\"rsvp_responses\".\"guests\") = 'array'\n        then jsonb_array_length(\"rsvp_responses\".\"guests\") between 1 and 20 and pg_column_size(\"rsvp_responses\".\"guests\") <= 16384\n        else false end"
        },
        "rsvp_responses_shuttle_seats_range": {
