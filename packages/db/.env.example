# Copy to packages/db/.env (gitignored). Neon project in aws-ap-southeast-1; use the dev branch locally.

# App login role (member of ww_app, NOBYPASSRLS) — pooled host (`-pooler`). Used by the app + live isolation test.
DATABASE_URL=postgres://ww_app_login:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Owner role — direct (non-pooled) host. Migrations + demo seed only; never give this to the app.
MIGRATE_DATABASE_URL=postgres://neondb_owner:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
