# Copy to apps/web/.env.local (gitignored).

# App login role (member of ww_app, NOBYPASSRLS), pooled host. Never the owner role.
DATABASE_URL=postgres://ww_app_login:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Platform apex. `{slug}.ROOT_DOMAIN` routes to that site; the apex serves `/s/{slug}`.
ROOT_DOMAIN=localhost

# Single-client deploy: pin every request, on any host, to this site slug. Leave empty for multi-tenant.
SINGLE_TENANT_SLUG=

# Default-site mode: the platform host serves this site at `/`, `/rsvp`, … instead of the landing
# page, and SHOWCASE_MODE is ignored. `/s/{slug}`, subdomains and custom domains keep working.
# Ignored when SINGLE_TENANT_SLUG is set. Leave empty to show the landing page.
DEFAULT_SITE_SLUG=

# Portfolio demo (landing-page mode only; off when DEFAULT_SITE_SLUG is set): set to 1 to show a "this is a demo" banner linking back to the landing page.
SHOWCASE_MODE=
